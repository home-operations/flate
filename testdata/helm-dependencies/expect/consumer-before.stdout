---
apiVersion: v1
data:
  value: before
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: consumer-output
  namespace: flux-system
---
apiVersion: v1
data:
  value: stable
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: rendered-dependency
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: dependency-output
  namespace: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: emitter
    helm.toolkit.fluxcd.io/namespace: flux-system
  name: rendered-dependency
  namespace: flux-system
spec:
  interval: 10m
  path: ./apps/dependency
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
