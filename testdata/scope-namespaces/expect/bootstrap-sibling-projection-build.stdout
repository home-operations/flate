[
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "sibling",
        "kustomize.toolkit.fluxcd.io/namespace": "apps"
      },
      "name": "leaf",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "sibling",
      "namespace": "apps"
    },
    "spec": {
      "path": "./leaf",
      "targetNamespace": "apps"
    }
  }
]
