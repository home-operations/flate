[
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "child",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "child-output"
    }
  },
  {
    "apiVersion": "example.test/v1",
    "kind": "Kustomization",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "parent",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "child",
      "namespace": "flux-system"
    },
    "spec": {
      "value": "first"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "parent",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "child",
      "namespace": "flux-system"
    },
    "spec": {
      "path": "./apps/child",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "flux-system"
      }
    }
  }
]
