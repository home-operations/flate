---
apiVersion: v1
data:
  value: ${VALUE}
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: rendered
  namespace: apps
---
apiVersion: v1
kind: Secret
metadata:
  annotations:
    example.test/note: repository
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
    retained: repository
  name: input
  namespace: apps
stringData:
  VALUE: ENC[AES256_GCM,data:x,iv:y,tag:z,type:str]
type: Opaque
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  path: ./flux-system/app
