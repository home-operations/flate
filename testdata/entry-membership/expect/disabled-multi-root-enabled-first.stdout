---
apiVersion: v1
data:
  value: retained
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: parent
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: app-admission-control
  namespace: games
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: parent
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: disabled
  namespace: games
spec:
  components:
  - ../backup
  path: ./targets/game
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
