        },
        {
          "app": "frigate"
        }
      ],
      "resources": [
        {
          "apiVersion": "v1",
          "data": {
            "deployment": "\u003c\u003c inputs.app \u003e\u003e"
          },
          "kind": "ConfigMap",
          "metadata": {
            "name": "\u003c\u003c inputs.app \u003e\u003e-nfs-scaler",
