---
apiVersion: v1
data:
  value: tagged
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: z-pinned
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: hello
  namespace: apps
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: z-pinned
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: a-held
  namespace: flux-system
spec:
  interval: 10m
  path: ./ok
  sourceRef:
    kind: GitRepository
    name: unknown
  suspend: true
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: z-sources
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: pinned
  namespace: flux-system
spec:
  interval: 10m
  ref:
    tag: v1.0.0
  url: git://fixture.invalid/cluster
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: z-stage
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: z-sources
  namespace: flux-system
spec:
  interval: 10m
  path: ./sources
  sourceRef:
    kind: GitRepository
    name: flux-system
