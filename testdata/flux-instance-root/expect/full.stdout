[
  {
    "apiVersion": "helm.toolkit.fluxcd.io/v2",
    "kind": "HelmRelease",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "sync",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "flux-instance",
      "namespace": "flux-system"
    },
    "spec": {
      "chart": {
        "spec": {
          "chart": "charts/bootstrap",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "bootstrap"
          }
        }
      },
      "interval": "10m"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "sync",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "plex",
      "namespace": "media"
    },
    "spec": {
      "interval": "1h",
      "patches": [
        {
          "patch": "- op: add\n  path: /spec/install\n  value: {crds: CreateReplace}\n- op: add\n  path: /spec/rollback\n  value: {cleanupOnFail: true}\n- op: add\n  path: /spec/upgrade\n  value:\n    cleanupOnFail: true\n    crds: CreateReplace\n    strategy: {name: RemediateOnFailure}\n    remediation: {remediateLastFailure: true, retries: 2}",
          "target": {
            "kind": "HelmRelease",
            "name": "plex",
            "namespace": "media"
          }
        }
      ],
      "path": "./plex",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "bootstrap",
        "namespace": "flux-system"
      }
    }
  },
  {
    "apiVersion": "helm.toolkit.fluxcd.io/v2",
    "kind": "HelmRelease",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "plex",
        "kustomize.toolkit.fluxcd.io/namespace": "media"
      },
      "name": "plex",
      "namespace": "media"
    },
    "spec": {
      "chart": {
        "spec": {
          "chart": "charts/plex",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "bootstrap",
            "namespace": "flux-system"
          }
        }
      },
      "install": {
        "crds": "CreateReplace"
      },
      "interval": "10m",
      "rollback": {
        "cleanupOnFail": true
      },
      "upgrade": {
        "cleanupOnFail": true,
        "crds": "CreateReplace",
        "remediation": {
          "remediateLastFailure": true,
          "retries": 2
        },
        "strategy": {
          "name": "RemediateOnFailure"
        }
      }
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "sync",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "10m0s",
      "patches": [
        {
          "patch": "- op: add\n  path: /spec/patches\n  value:\n    - target: {kind: HelmRelease, name: plex, namespace: media}\n      patch: |\n        - op: add\n          path: /spec/install\n          value: {crds: CreateReplace}\n        - op: add\n          path: /spec/rollback\n          value: {cleanupOnFail: true}\n        - op: add\n          path: /spec/upgrade\n          value:\n            cleanupOnFail: true\n            crds: CreateReplace\n            strategy: {name: RemediateOnFailure}\n            remediation: {remediateLastFailure: true, retries: 2}",
          "target": {
            "kind": "Kustomization",
            "name": "plex",
            "namespace": "media"
          }
        }
      ],
      "path": "./kubernetes/apps",
      "prune": true,
      "serviceAccountName": "sync-service-account",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "sync"
      }
    }
  }
]
