---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: demo
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: demo
  namespace: apps
spec:
  chartRef:
    kind: HelmChart
    name: demo
    namespace: flux-system
  interval: 10m
---
apiVersion: v1
data:
  greeting: production
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: demo
    helm.toolkit.fluxcd.io/namespace: apps
  name: demo-values
  namespace: apps
