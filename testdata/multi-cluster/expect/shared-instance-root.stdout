[
  {
    "cluster": "main/sync",
    "documents": [
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "apps",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "workload",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./payload",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "cluster-repository"
          }
        }
      },
      {
        "apiVersion": "v1",
        "data": {
          "value": "main"
        },
        "kind": "ConfigMap",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "flux-system",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "marker",
          "namespace": "apps"
        }
      },
      {
        "apiVersion": "fluxcd.controlplane.io/v1",
        "kind": "FluxInstance",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "flux-system",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "flux",
          "namespace": "flux-system"
        },
        "spec": {
          "sync": {
            "kind": "GitRepository",
            "name": "flux-system",
            "path": "./main/sync",
            "ref": "refs/heads/main",
            "url": "https://example.invalid/cluster.git"
          }
        }
      },
      {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "flux-system",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "cluster-repository",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "1m",
          "url": "https://example.invalid/cluster.git"
        }
      },
      {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {
          "name": "flux-system",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "1m0s",
          "ref": {
            "name": "refs/heads/main"
          },
          "url": "https://example.invalid/cluster.git"
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "flux-system",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "apps",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./shared",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "cluster-repository"
          }
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "flux-system",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "10m0s",
          "path": "./main/sync",
          "prune": true,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system"
          }
        }
      },
      {
        "apiVersion": "v1",
        "data": {
          "value": "common"
        },
        "kind": "ConfigMap",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "workload",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "shared",
          "namespace": "apps"
        }
      }
    ]
  },
