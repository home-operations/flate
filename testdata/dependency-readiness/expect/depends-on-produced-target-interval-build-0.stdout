---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  dependsOn:
  - name: generated-raw-done
  interval: 2h
  path: ./kubernetes/hegira/app
  postBuild:
    substitute:
      VALUE: before
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: producer
  namespace: apps
spec:
  path: ./kubernetes/hegira/producer
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: unrelated
  namespace: apps
spec:
  path: ./kubernetes/hegira/unrelated
