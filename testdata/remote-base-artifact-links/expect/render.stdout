---
apiVersion: v1
data:
  key: value
kind: ConfigMap
metadata:
  annotations:
    config.kubernetes.io/origin: |
      configuredIn: child/cm.yaml
      configuredBy:
        apiVersion: builtin
        kind: ConfigMapGenerator
        name: child
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: child
