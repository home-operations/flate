---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: first
  namespace: apps
spec:
  interval: 2m
  path: ./workloads/first
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: second
  namespace: apps
spec:
  interval: 1m
  path: ./workloads/second
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: first
  namespace: apps
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: second
  namespace: apps
