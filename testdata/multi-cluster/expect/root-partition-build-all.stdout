[
  {
    "cluster": "main",
    "documents": [
      {
        "apiVersion": "fluxcd.controlplane.io/v1",
        "kind": "FluxInstance",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "cluster",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "cluster",
          "namespace": "flux-system"
        },
        "spec": {
          "sync": {
            "kind": "GitRepository",
            "name": "cluster",
            "path": "./main",
            "ref": "refs/heads/main",
            "url": "https://example.invalid/cluster.git"
          }
        }
      },
      {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {
          "name": "cluster",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "1m0s",
          "ref": {
            "name": "refs/heads/main"
          },
          "url": "https://example.invalid/cluster.git"
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "cluster",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "10m0s",
          "path": "./main",
          "prune": true,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "cluster"
          }
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "cluster",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "shared",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./main/app",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system"
          }
        }
      },
      {
        "apiVersion": "v1",
        "data": {
          "value": "main"
        },
        "kind": "ConfigMap",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "shared",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "shared",
          "namespace": "apps"
        }
      }
    ]
  },
