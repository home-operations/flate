---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: healthy
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: independent-output
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: owner
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: invalid
  namespace: flux-system
spec:
  chart:
    spec:
      chart: charts/demo
      sourceRef:
        kind: GitRepository
        name: flux-system
  interval: 10m
  suspend: true
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: healthy
  namespace: flux-system
spec:
  path: ./healthy
  sourceRef:
    kind: GitRepository
    name: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: owner
  namespace: flux-system
spec:
  path: ./app
  sourceRef:
    kind: GitRepository
    name: flux-system
