---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: a
  namespace: flux-system
spec:
  dependsOn:
  - name: b
  path: ./kubernetes/cluster/a
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: b
  namespace: flux-system
spec:
  dependsOn:
  - name: a
  path: ./kubernetes/cluster/b
