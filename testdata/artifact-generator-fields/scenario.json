  "cases": [
    {
      "name": "artifact-generator--output-fields",
      "description": "Render Sonarr and both gateways from artifacts in their own namespaces.",
      "setup": [
        {
          "commit": "base"
        }
      ],
      "cache": {
        "repeat": "reuse"
      },
      "steps": [
        {
          "id": "sonarr",
          "invoke": {
            "argv": [
              "build",
              "ks",
              "--namespace",
              "media",
              "sonarr",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/sonarr.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        },
        {
          "id": "all",
          "invoke": {
            "argv": [
              "build",
              "all",
              "--only-kinds=ConfigMap",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/all.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        }
      ]
    },
    {
      "name": "artifact-generator--required-copy",
      "description": "Report the missing Sonarr base when the copy is required.",
      "setup": [
        {
          "commit": "base"
        },
        {
          "overlay": "required"
        }
      ],
      "cache": {
        "repeat": "reuse"
      },
      "steps": [
        {
          "id": "required",
          "invoke": {
            "argv": [
              "build",
              "all",
              "--only-kinds=ConfigMap",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/required.stdout",
              "stderr": "expect/required.stderr",
              "code": 1
            }
          }
        }
      ]
    },
    {
      "name": "artifact-generator--inputs-forward",
      "description": "Compare a source input edit with its base.",
      "setup": [
        {
          "commit": "input-only"
        }
      ],
      "cache": {
        "repeat": "reuse"
      },
      "steps": [
        {
          "id": "forward",
          "invoke": {
            "argv": [
              "diff",
              "all",
              "--skip-kinds=",
              "-o",
              "diff",
              "--base",
              "@@commit:base@@",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/forward.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        }
      ]
    },
    {
      "name": "artifact-generator--inputs-reverse",
      "description": "Compare the original source input with the edited revision.",
      "setup": [
        {
          "commit": "base"
        }
      ],
      "cache": {
        "repeat": "reuse"
      },
      "steps": [
        {
          "id": "reverse",
