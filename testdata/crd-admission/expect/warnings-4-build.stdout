[
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "OCIRepository",
    "metadata": {
      "labels": {
        "resourceset.fluxcd.controlplane.io/name": "z-dependent",
        "resourceset.fluxcd.controlplane.io/namespace": "flux-system"
      },
      "name": "flux-operator",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "1h",
      "ref": {
        "semver": "*"
      },
      "suspend": true,
      "url": "oci://ghcr.io/controlplaneio-fluxcd/charts/flux-operator",
      "verify": {
        "matchOIDCIdentity": [
          {
            "issuer": "^https://token\\.actions\\.githubusercontent\\.com$",
            "subject": "^https://github\\.com/controlplaneio-fluxcd/charts/\\.github/workflows/release\\.yml@refs/tags/v\\d+\\.\\d+\\.\\d+$"
          }
        ],
        "provider": "cosign"
      }
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "apps",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "flux-operator",
      "namespace": "flux-system"
    },
    "spec": {
      "dependsOn": [
        {
          "apiVersion": "apiextensions.k8s.io/v1",
          "kind": "CustomResourceDefinition",
          "name": "helmreleases.helm.toolkit.fluxcd.io"
        },
        {
          "apiVersion": "apiextensions.k8s.io/v1",
          "kind": "CustomResourceDefinition",
          "name": "helmreleases.helm.toolkit.fluxcd.io"
        },
        {
          "apiVersion": "apiextensions.k8s.io/v1",
          "kind": "CustomResourceDefinition",
          "name": "widgets.example.com"
        }
      ],
      "resources": [
        {
          "apiVersion": "source.toolkit.fluxcd.io/v1",
          "kind": "OCIRepository",
          "metadata": {
            "name": "flux-operator",
            "namespace": "flux-system"
          },
          "spec": {
            "interval": "1h",
            "ref": {
              "semver": "*"
            },
            "suspend": true,
            "url": "oci://ghcr.io/controlplaneio-fluxcd/charts/flux-operator",
            "verify": {
              "matchOIDCIdentity": [
                {
                  "issuer": "^https://token\\.actions\\.githubusercontent\\.com$",
                  "subject": "^https://github\\.com/controlplaneio-fluxcd/charts/\\.github/workflows/release\\.yml@refs/tags/v\\d+\\.\\d+\\.\\d+$"
                }
              ],
              "provider": "cosign"
            }
          }
        },
        {
          "apiVersion": "helm.toolkit.fluxcd.io/v2",
          "kind": "HelmRelease",
          "metadata": {
            "name": "flux-operator",
            "namespace": "flux-system"
          },
          "spec": {
            "chartRef": {
              "kind": "OCIRepository",
              "name": "flux-operator"
            },
            "interval": "1h",
            "releaseName": "flux-operator",
            "serviceAccountName": "flux-operator",
            "suspend": true,
            "values": {
              "multitenancy": {
                "defaultServiceAccount": "default",
                "enabled": true
              },
              "reporting": {
                "interval": "5m"
              }
            }
          }
        }
      ],
      "serviceAccountName": "flux-operator"
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "apps",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "z-dependent",
