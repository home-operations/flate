---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: dev-config
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: config-ready
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: parent
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: child
  namespace: flux-system
spec:
  dependsOn:
  - name: ${PREFIX:-dev-}config
  path: ./kubernetes/hegira/app
