[
  {
    "apiVersion": "v1",
    "data": {
      "greeting": "hello-from-backend"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "apps-backend",
        "kustomize.toolkit.fluxcd.io/namespace": "backend"
      },
      "name": "backend-config",
      "namespace": "backend"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "flate",
        "resourceset.fluxcd.controlplane.io/name": "apps",
        "resourceset.fluxcd.controlplane.io/namespace": "flux-system"
      },
      "name": "backend"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "flate",
        "resourceset.fluxcd.controlplane.io/name": "apps",
        "resourceset.fluxcd.controlplane.io/namespace": "flux-system"
      },
      "name": "frontend"
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "cluster-tenants",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "apps",
      "namespace": "flux-system"
    },
    "spec": {
      "commonMetadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "flate"
        }
      },
      "inputs": [
        {
          "tenant": "frontend"
        },
        {
          "tenant": "backend"
        }
      ],
      "resources": [
        {
          "apiVersion": "v1",
          "kind": "Namespace",
          "metadata": {
            "name": "\u003c\u003c inputs.tenant \u003e\u003e"
          }
        },
        {
          "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
          "kind": "Kustomization",
          "metadata": {
            "name": "apps-\u003c\u003c inputs.tenant \u003e\u003e",
            "namespace": "\u003c\u003c inputs.tenant \u003e\u003e"
          },
          "spec": {
            "interval": "10m",
            "path": "./tenants/\u003c\u003c inputs.tenant \u003e\u003e",
            "prune": true,
            "sourceRef": {
              "kind": "GitRepository",
              "name": "flux-system",
              "namespace": "flux-system"
            }
          }
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "data": {
      "greeting": "hello-from-frontend"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "apps-frontend",
        "kustomize.toolkit.fluxcd.io/namespace": "frontend"
      },
      "name": "frontend-config",
      "namespace": "frontend"
    }
  }
]
