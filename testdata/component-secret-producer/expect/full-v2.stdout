[
  {
    "apiVersion": "helm.toolkit.fluxcd.io/v2",
    "kind": "HelmRelease",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "paperwork-paperless",
        "kustomize.toolkit.fluxcd.io/namespace": "paperwork"
      },
      "name": "paperless",
      "namespace": "paperwork"
    },
    "spec": {
      "chart": {
        "spec": {
          "chart": "./charts/paperless",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system",
            "namespace": "flux-system"
          }
        }
      },
      "interval": "1h",
      "values": {
        "image": {
          "tag": "v2"
        }
      }
    }
  },
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/origin": "path: ../../../../components/bucket/external.yaml\n"
      },
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "paperwork-paperless-bucket",
        "kustomize.toolkit.fluxcd.io/namespace": "paperwork"
      },
      "name": "paperless",
      "namespace": "paperwork"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "bucket"
          },
          "secretKey": "VALUE"
        }
      ],
      "target": {
        "name": "paperless"
      }
    }
  },
  {
    "apiVersion": "external-secrets.io/v1",
    "kind": "ExternalSecret",
    "metadata": {
      "annotations": {
        "config.kubernetes.io/origin": "path: ../../../../components/bucket/external.yaml\n"
      },
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "paperwork-paperless-unused-bucket",
        "kustomize.toolkit.fluxcd.io/namespace": "paperwork"
      },
      "name": "unused",
      "namespace": "paperwork"
    },
    "spec": {
      "data": [
        {
          "remoteRef": {
            "key": "bucket"
          },
          "secretKey": "VALUE"
        }
      ],
      "target": {
        "name": "unused"
      }
    }
  },
  {
    "apiVersion": "v1",
    "data": {
      "value": "sentinel"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "unrelated",
        "kustomize.toolkit.fluxcd.io/namespace": "paperwork"
      },
      "name": "unrelated",
      "namespace": "paperwork"
    }
  }
]
