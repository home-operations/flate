---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: sync
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: alternate-application
  namespace: apps
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: workload
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: workload
  namespace: apps
spec:
  chart:
    spec:
      chart: charts/workload
      sourceRef:
        kind: GitRepository
        name: self
        namespace: apps
  values:
    value: after
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: generator
    helm.toolkit.fluxcd.io/namespace: apps
  name: sync
  namespace: apps
spec:
  interval: 1h
  path: ./elsewhere
  sourceRef:
    kind: GitRepository
    name: self
    namespace: apps
---
apiVersion: v1
data:
  value: after
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: workload
    helm.toolkit.fluxcd.io/namespace: apps
  name: workload
  namespace: apps
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: literal-layer
  namespace: apps
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: self
  namespace: apps
spec:
  url: https://example.test/entry/repo
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: generator
  namespace: apps
spec:
  chart:
    spec:
      chart: charts/bootstrap
      sourceRef:
        kind: GitRepository
        name: self
        namespace: apps
  interval: 10m
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: workload
  namespace: apps
spec:
  interval: 2h
  path: ./workload
  sourceRef:
    kind: GitRepository
    name: self
    namespace: apps
