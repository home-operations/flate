---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    resourceset.fluxcd.controlplane.io/name: apps
    resourceset.fluxcd.controlplane.io/namespace: flux-system
  name: app
  namespace: flux-system
spec:
  chart:
    spec:
      chart: ./charts/app
      sourceRef:
        kind: GitRepository
        name: flux-system
        namespace: flux-system
---
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: apps
  namespace: flux-system
spec:
  inputsFrom:
  - kind: ResourceSetInputProvider
    selector:
      matchLabels:
        fixture.test/apps: generated
  resourcesTemplate: |
    apiVersion: helm.toolkit.fluxcd.io/v2
    kind: HelmRelease
    metadata:
      name: << inputs.name >>
      namespace: flux-system
    spec:
      chart:
        spec:
          chart: ./charts/<< inputs.name >>
          sourceRef: {kind: GitRepository, name: flux-system, namespace: flux-system}
---
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSetInputProvider
metadata:
  labels:
    fixture.test/apps: generated
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: app
  namespace: flux-system
spec:
  defaultValues:
    name: app
  type: Static
---
apiVersion: v1
data:
  library: after
  template: before
  value: before
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: app
    helm.toolkit.fluxcd.io/namespace: flux-system
  name: app
  namespace: flux-system
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: ExternalArtifact
metadata:
  labels:
    app.kubernetes.io/managed-by: source-watcher
    source.extensions.fluxcd.io/generator: ""
  name: apps
  namespace: flux-system
spec:
  sourceRef:
    apiVersion: source.extensions.fluxcd.io/v1beta1
    kind: ArtifactGenerator
    name: flux-system
    namespace: flux-system
