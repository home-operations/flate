# Cluster: clusters/left
---
apiVersion: v1
data:
  value: after
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: left-workload
  namespace: flux-system
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: release
  namespace: flux-system
spec:
  chart:
    spec:
      chart: witness
      sourceRef:
        kind: HelmRepository
        name: charts
  interval: 1h
  suspend: true
---
apiVersion: v1
data:
  value: remote
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: external
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: upstream-workload
  namespace: flux-system
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: flux-system
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: external
  namespace: flux-system
spec:
  ref:
    branch: main
  url: https://upstream.example.invalid/fleet-overlay.git
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: flux-system
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: flux-system
  namespace: flux-system
spec:
  interval: 30m
  ref:
    branch: main
  secretRef:
    name: flux-system
  url: ssh://git@github.com/tyzbit/fleet-infra
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: flux-system
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: charts
  namespace: flux-system
spec:
  interval: 1h
  type: oci
  url: oci://charts.example.invalid/left
# Cluster: clusters/right
---
apiVersion: v1
data:
  value: before
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: right-workload
  namespace: flux-system
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: release
  namespace: flux-system
spec:
  chart:
    spec:
      chart: witness
      sourceRef:
        kind: HelmRepository
        name: charts
  interval: 1h
  suspend: true
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: flux-system
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: flux-system
  namespace: flux-system
spec:
  interval: 45m
  ref:
    branch: main
  secretRef:
    name: flux-system
  url: ssh://git@github.com/tyzbit/fleet-infra
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: flux-system
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: charts
  namespace: flux-system
spec:
  interval: 1h
  type: oci
  url: oci://charts.example.invalid/right
