---
apiVersion: v1
data:
  value: after
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: generated-config
  namespace: apps
---
apiVersion: source.extensions.fluxcd.io/v1beta1
kind: ArtifactGenerator
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: owner
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: generator
  namespace: apps
  uid: authored
spec:
  artifacts:
  - copy:
    - from: '@repo/app/kustomization.yaml'
      to: '@artifact/app/kustomization.yaml'
    - from: '@repo/after.yaml'
      to: '@artifact/app/cm.yaml'
    name: generated
  sources:
  - alias: repo
    kind: GitRepository
    name: missing
---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: owner
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: owner-marker
  namespace: apps
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: ExternalArtifact
metadata:
  labels:
    app.kubernetes.io/managed-by: source-watcher
    source.extensions.fluxcd.io/generator: authored
  name: generated
  namespace: apps
spec:
  sourceRef:
    apiVersion: source.extensions.fluxcd.io/v1beta1
    kind: ArtifactGenerator
    name: generator
    namespace: apps
