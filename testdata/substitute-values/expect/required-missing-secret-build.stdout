---
apiVersion: v1
kind: Pod
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: cloudflare-tunnel
    kustomize.toolkit.fluxcd.io/namespace: network
  name: cloudflare-tunnel
  namespace: network
spec:
  containers:
  - env:
    - name: TUNNEL_ID
      value: offline
    image: example.invalid/cloudflared:v2
    name: cloudflared
