---
apiVersion: v1
data:
  version: 4.6.2
kind: ConfigMap
metadata:
  labels:
    changed: consumer
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: output
  namespace: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: parent
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: consumer
  namespace: flux-system
spec:
  path: ./kubernetes/cluster/app
  postBuild:
    substituteFrom:
    - kind: Secret
      name: settings
      optional: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
