              "diff",
              "all",
              "--skip-kinds=",
              "-o",
              "diff",
              "--base",
              "@@commit:input-only@@",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/reverse.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        }
      ]
    }
