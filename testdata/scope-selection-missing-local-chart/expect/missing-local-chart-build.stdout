[
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "spec": {
      "url": "https://fixture.invalid/cluster.git"
    }
  },
  {
    "apiVersion": "helm.toolkit.fluxcd.io/v2",
    "kind": "HelmRelease",
    "metadata": {
      "name": "probe",
      "namespace": "flux-system"
    },
    "spec": {
      "chart": {
        "spec": {
          "chart": "./charts/nochart",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system",
            "namespace": "flux-system"
          }
        }
      },
      "interval": "10m"
    }
  }
]
