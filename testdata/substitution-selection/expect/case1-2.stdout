---
apiVersion: v1
data:
  X: "1"
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: a
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: vars
  namespace: flux-system
---
apiVersion: v1
data:
  v: "2"
  x: 1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: b
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: out
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: root
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: a
  namespace: flux-system
spec:
  path: ./a
  sourceRef:
    kind: GitRepository
    name: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: root
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: b
  namespace: flux-system
spec:
  path: ./b
  postBuild:
    substituteFrom:
    - kind: ConfigMap
      name: vars
  sourceRef:
    kind: GitRepository
    name: flux-system
