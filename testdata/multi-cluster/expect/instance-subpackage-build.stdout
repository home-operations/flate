[
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "flux-system",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "marker",
      "namespace": "default"
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "FluxInstance",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "flux-system",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "flux",
      "namespace": "flux-system"
    },
    "spec": {
      "sync": {
        "kind": "GitRepository",
        "path": "clusters/x",
        "ref": "refs/heads/main",
        "url": "https://example.invalid/cluster.git"
      }
    }
  },
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "1m0s",
      "ref": {
        "name": "refs/heads/main"
      },
      "url": "https://example.invalid/cluster.git"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "10m0s",
      "path": "clusters/x",
      "prune": true,
      "sourceRef": {
        "kind": "GitRepository",
        "name": "flux-system"
      }
    }
  }
]
