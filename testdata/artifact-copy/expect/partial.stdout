---
apiVersion: v1
data:
  value: a
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: a
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: accepted-a
  namespace: apps
---
apiVersion: v1
data:
  value: b
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: b
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: accepted-b
  namespace: apps
---
apiVersion: source.extensions.fluxcd.io/v1beta1
kind: ArtifactGenerator
metadata:
  name: generator
  namespace: apps
  uid: authored
spec:
  artifacts:
  - copy:
    - from: '@repo/a/'
      to: '@artifact/'
    name: generated-a
  - copy:
    - from: '@repo/b/'
      to: '@artifact/'
    name: generated-b
  - copy:
    - from: '@repo/c/'
      to: '@artifact/'
    name: generated-c
  sources:
  - alias: repo
    kind: GitRepository
    name: missing
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: ExternalArtifact
metadata:
  labels:
    app.kubernetes.io/managed-by: source-watcher
    source.extensions.fluxcd.io/generator: authored
  name: generated-a
  namespace: apps
spec:
  sourceRef:
    apiVersion: source.extensions.fluxcd.io/v1beta1
    kind: ArtifactGenerator
    name: generator
    namespace: apps
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: ExternalArtifact
metadata:
  labels:
    app.kubernetes.io/managed-by: source-watcher
    source.extensions.fluxcd.io/generator: authored
  name: generated-b
  namespace: apps
spec:
  sourceRef:
    apiVersion: source.extensions.fluxcd.io/v1beta1
    kind: ArtifactGenerator
    name: generator
    namespace: apps
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: a
  namespace: apps
spec:
  interval: 1m
  path: ./a
  sourceRef:
    kind: ExternalArtifact
    name: generated-a
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: b
  namespace: apps
spec:
  interval: 1m
  path: ./b
  sourceRef:
    kind: ExternalArtifact
    name: generated-b
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: c
  namespace: apps
spec:
  interval: 1m
  path: ./c
  sourceRef:
    kind: ExternalArtifact
    name: generated-c
