---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: infra
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: infra
  namespace: apps
spec:
  chart:
    spec:
      chart: demo
      sourceRef:
        kind: HelmRepository
        name: charts
      version: 0.1.0
  interval: 10m
  releaseName: infra
  targetNamespace: infra
  values:
    value: old
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: nested
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: nested
  namespace: apps
spec:
  chart:
    spec:
      chart: demo
      sourceRef:
        kind: HelmRepository
        name: charts
      version: 0.1.0
  interval: 10m
  releaseName: nested
  targetNamespace: nested
  values:
    value: old
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: nested
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: nested
  namespace: apps
spec:
  interval: 10m
  path: ./apps/nested
  prune: false
  sourceRef:
    kind: GitRepository
    name: sync
