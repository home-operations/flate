          }
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "name": "flux-system",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "10m0s",
          "path": "./clusters/test",
          "prune": true,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system"
          }
        }
      }
    ]
  }
]
