          <td class="diff-code"><span class="w">    </span><span class="nt">kustomize.toolkit.fluxcd.io/name</span><span class="p">:</span><span class="w"> </span><span class="l">app</span></td>
        </tr><tr class="row-ctx">
          <td class="diff-lineno">10</td>
          <td class="diff-lineno">10</td>
          <td class="diff-code"><span class="w">    </span><span class="nt">kustomize.toolkit.fluxcd.io/namespace</span><span class="p">:</span><span class="w"> </span><span class="l">apps</span></td>
        </tr><tr class="hunk" data-fold="r0-g1"><td colspan="3"><button type="button" class="expander">&#8597; Expand 3 lines</button></td></tr><tr class="row-ctx folded" data-fold="r0-g1">
          <td class="diff-lineno">11</td>
          <td class="diff-lineno">11</td>
          <td class="diff-code"><span class="w">  </span><span class="nt">name</span><span class="p">:</span><span class="w"> </span><span class="l">app</span></td>
        </tr><tr class="row-ctx folded" data-fold="r0-g1">
          <td class="diff-lineno">12</td>
          <td class="diff-lineno">12</td>
          <td class="diff-code"><span class="w">  </span><span class="nt">namespace</span><span class="p">:</span><span class="w"> </span><span class="l">apps</span></td>
        </tr><tr class="row-ctx folded" data-fold="r0-g1">
          <td class="diff-lineno">13</td>
