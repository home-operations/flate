---
apiVersion: v1
data:
  revision: before
  version: v1-promoted
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: child
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: emitted-output
  namespace: apps
---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: unrelated
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: unrelated-output
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: parent
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: child
  namespace: apps
spec:
  dependsOn:
  - name: config
    readyExpr: self.metadata.namespace == 'apps' && self.metadata.namespace == dep.metadata.namespace
      && self.spec.postBuild.substitute.releaseVersion == dep.spec.postBuild.substitute.releaseVersion
  path: ./kubernetes/hegira/app
  postBuild:
    substitute:
      releaseVersion: v1
    substituteFrom:
    - kind: ConfigMap
      name: settings
  targetNamespace: apps
