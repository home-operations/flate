---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: cluster-config
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: cluster
  namespace: flux-system
spec:
  url: https://fixture.invalid/repo
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: cluster-config
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: cluster-config
  namespace: flux-system
spec:
  path: ./clusters/local/flux
  postBuild:
    substitute:
      CLUSTER_NAME: local
    substituteFrom:
    - kind: Secret
      name: missing
  sourceRef:
    kind: GitRepository
    name: cluster
