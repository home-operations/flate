[
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "spec": {
      "url": "https://fixture.invalid/cluster.git"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "probe",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "10m",
      "path": "./apps",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "flux-system",
        "namespace": "flux-system"
      }
    }
  }
]
