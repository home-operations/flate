---
apiVersion: v1
data:
  site: b
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: child
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: cm-two
  namespace: default
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: root-b
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: child
  namespace: flux-system
spec:
  interval: 10m
  path: ./payload/two
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
