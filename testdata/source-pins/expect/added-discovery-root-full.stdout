  {
    "apiVersion": "v1",
    "data": {
      "value": "phantom"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "resourceset.fluxcd.controlplane.io/name": "added-rs",
        "resourceset.fluxcd.controlplane.io/namespace": "flux-system"
      },
      "name": "added-rs-output",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "cluster",
      "namespace": "flux-system"
    },
    "spec": {
      "ignore": "/ignored.txt",
      "interval": "10m",
      "ref": {
        "tag": "v1.0.0"
      },
      "url": "git://fixture.invalid/cluster"
    }
  },
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "working",
      "namespace": "flux-system"
    },
    "spec": {
      "url": "git://fixture.invalid/cluster"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "added-ks",
      "namespace": "flux-system"
    },
    "spec": {
      "path": "./apps/phantom",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "working",
        "namespace": "flux-system"
      }
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "apps",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "10m",
      "path": "./apps",
      "sourceRef": {
        "kind": "GitRepository",
        "name": "cluster",
        "namespace": "flux-system"
      }
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "name": "added-rs",
      "namespace": "flux-system"
    },
    "spec": {
      "resourcesTemplate": "apiVersion: v1\nkind: ConfigMap\nmetadata: {name: added-rs-output, namespace: apps}\ndata: {value: phantom}\n"
    }
  }
