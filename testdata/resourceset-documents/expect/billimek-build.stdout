      },
      "name": "audiobookshelf-nfs-scaler",
      "namespace": "default"
    }
  },
  {
    "apiVersion": "v1",
    "data": {
      "deployment": "frigate"
    },
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "resourceset.fluxcd.controlplane.io/name": "nfs-scalers",
        "resourceset.fluxcd.controlplane.io/namespace": "kube-system"
      },
      "name": "frigate-nfs-scaler",
      "namespace": "default"
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "apps",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "nfs-scalers",
      "namespace": "kube-system"
