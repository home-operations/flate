---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: demo
    helm.toolkit.fluxcd.io/namespace: apps
  name: chart-sibling
  namespace: apps
---
apiVersion: v1
data:
  greeting: hello-from-helm
  replicas: "3"
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: demo
    helm.toolkit.fluxcd.io/namespace: apps
  name: demo-cm
  namespace: apps
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: demo
    helm.toolkit.fluxcd.io/namespace: apps
  name: invalid
spec:
  chart:
    spec:
      chart: demo
      sourceRef:
        kind: HelmRepository
        name: charts
  interval: []
  suspend: true
