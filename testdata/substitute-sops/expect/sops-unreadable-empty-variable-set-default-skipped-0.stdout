---
apiVersion: v1
data:
  value: ${VALUE}
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: rendered
  namespace: apps
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  path: ./flux-system/app
  postBuild:
    substituteFrom:
    - kind: Secret
      name: input
