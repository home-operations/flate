---
apiVersion: v1
data:
  value: null
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: rendered
  namespace: apps
---
apiVersion: v1
kind: Secret
metadata:
  annotations:
    example.test/note: repository
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
    retained: repository
  name: input
  namespace: apps
stringData: {}
type: Opaque
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  path: ./flux-system/app
  postBuild:
    substitute:
      READABLE: inline
    substituteFrom:
    - kind: Secret
      name: input
