[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "helm.toolkit.fluxcd.io/name": "demo",
        "helm.toolkit.fluxcd.io/namespace": "default"
      },
      "name": "demo",
      "namespace": "default"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "demo"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "demo"
          }
        },
        "spec": {
          "containers": [
            {
              "image": "example.test/demo:1.0.0",
              "name": "demo"
            }
          ]
        }
      }
    }
  }
]
