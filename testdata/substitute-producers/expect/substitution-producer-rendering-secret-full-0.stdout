---
apiVersion: v1
data:
  version: 4.6.2
kind: ConfigMap
metadata:
  labels:
    changed: consumer
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: output
  namespace: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: flux-system
spec:
  dependsOn:
  - name: producer
  path: ./kubernetes/cluster/app
  postBuild:
    substituteFrom:
    - kind: Secret
      name: settings
      optional: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: producer
  namespace: flux-system
spec:
  patches:
  - patch: |-
      - op: replace
        path: /data/VERSION
        value: NC42LjI=
    target:
      kind: Secret
      name: settings
  path: ./kubernetes/cluster/data
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
