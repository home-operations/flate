    {
      "name": "artifact-generator--managed-render",
      "description": "Compare full and targeted rendering and prove offline service account parity.",
      "setup": [
        {
          "commit": "base"
        }
      ],
      "cache": {
        "repeat": "reuse"
      },
      "steps": [
        {
          "id": "full",
          "invoke": {
            "argv": [
              "build",
              "all",
              "--only-kinds=ConfigMap,Namespace",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/render.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        },
        {
          "id": "targeted",
          "invoke": {
            "argv": [
              "build",
              "ks",
              "consumer",
              "-n",
              "flux-system",
              "--only-kinds=ConfigMap,Namespace",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/targeted.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        },
        {
          "id": "generated",
          "invoke": {
            "argv": [
              "build",
              "all",
              "--only-kinds=ExternalArtifact,Namespace",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/generated.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        },
        {
          "id": "set-service-account",
          "edit": {
            "overlay": "account"
          }
        },
        {
          "id": "generated-with-service-account",
          "invoke": {
            "argv": [
              "build",
              "all",
              "--only-kinds=ExternalArtifact,Namespace",
              "--path",
              "@@repo@@/entry",
              "--concurrency=2",
              "--no-progress",
              "--cache-dir",
              "@@cache@@"
            ],
            "cache": {
              "name": "default"
            },
            "expect": {
              "stdout": "expect/generated.stdout",
              "stderr": "expect/success.stderr",
              "code": 0
            }
          }
        }
      ]
    },
