---
apiVersion: v1
data:
  value: after
kind: ConfigMap
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: consumer
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: consumer-output
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  interval: 1h
  path: ./kubernetes/hegira/app
  postBuild:
    substitute:
      VALUE: after
  sourceRef:
    kind: GitRepository
    name: input
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: producer
  namespace: apps
spec:
  path: ./kubernetes/hegira/producer
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: unrelated
  namespace: apps
spec:
  path: ./kubernetes/hegira/unrelated
