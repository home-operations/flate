[
  {
    "cluster": "first",
    "documents": [
      {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-first",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "payload-first"
        }
      },
      {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-first",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "source-first",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "1h",
          "url": "https://example.invalid/cluster.git"
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-first",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "sync-first",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./first",
          "prune": false,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "source-first"
          }
        }
      }
    ]
  },
  {
    "cluster": "second",
    "documents": [
      {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-second",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "payload-second"
        }
      },
      {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-second",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "source-second",
          "namespace": "flux-system"
        },
        "spec": {
          "interval": "1h",
          "url": "https://example.invalid/cluster.git"
        }
      },
      {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {
          "labels": {
            "kustomize.toolkit.fluxcd.io/name": "sync-second",
            "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
          },
          "name": "sync-second",
          "namespace": "flux-system"
        },
        "spec": {
          "path": "./second",
          "prune": false,
          "sourceRef": {
            "kind": "GitRepository",
            "name": "source-second"
          }
        }
      }
    ]
  }
]
