---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: consumer
  namespace: apps
spec:
  interval: 2h
  path: ./kubernetes/hegira/app
  postBuild:
    substitute:
      VALUE: before
  sourceRef:
    kind: GitRepository
    name: input
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: producer
  namespace: apps
spec:
  path: ./kubernetes/hegira/producer
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: unrelated
  namespace: apps
spec:
  path: ./kubernetes/hegira/unrelated
