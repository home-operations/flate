[
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "resourceset.fluxcd.controlplane.io/name": "rs-common",
        "resourceset.fluxcd.controlplane.io/namespace": "apps"
      },
      "name": "from-rs"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "annotations": {
        "kustomize.toolkit.fluxcd.io/substitute": "disabled",
        "note": "${VALUE}"
      },
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "ks-common",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "disabled",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "annotations": {
        "boolean": "false",
        "note": "expanded",
        "number": "1e3"
      },
      "labels": {
        "boolean": "true",
        "kustomize.toolkit.fluxcd.io/name": "ks-common",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system",
        "number": "1.00"
      },
      "name": "from-ks",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "helm.toolkit.fluxcd.io/v2",
    "kind": "HelmRelease",
    "metadata": {
      "annotations": {
        "note": "expanded"
      },
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "ks-common",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "release",
      "namespace": "apps"
    },
    "spec": {
      "chart": {
        "spec": {
          "chart": "./chart",
          "sourceRef": {
            "kind": "GitRepository",
            "name": "flux-system",
            "namespace": "flux-system"
          }
        }
      },
      "commonMetadata": {
        "labels": {
          "helm.toolkit.fluxcd.io/name": "hr-common"
        }
      },
      "interval": "1m"
    }
  },
  {
    "apiVersion": "fluxcd.controlplane.io/v1",
    "kind": "ResourceSet",
    "metadata": {
      "annotations": {
        "note": "expanded"
      },
      "labels": {
        "kustomize.toolkit.fluxcd.io/name": "ks-common",
        "kustomize.toolkit.fluxcd.io/namespace": "flux-system"
      },
      "name": "set",
      "namespace": "apps"
    },
    "spec": {
      "commonMetadata": {
        "labels": {
          "resourceset.fluxcd.controlplane.io/name": "rs-common"
        }
      },
      "resources": [
        {
          "apiVersion": "v1",
          "kind": "ConfigMap",
          "metadata": {
            "name": "from-rs"
          }
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "labels": {
        "helm.toolkit.fluxcd.io/name": "release",
        "helm.toolkit.fluxcd.io/namespace": "apps"
      },
      "name": "from-hr",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "source.toolkit.fluxcd.io/v1",
    "kind": "GitRepository",
    "metadata": {
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "spec": {
      "interval": "1m",
      "ref": {
        "branch": "main"
      },
      "url": "https://example.invalid/repo.git"
    }
  },
  {
    "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
    "kind": "Kustomization",
    "metadata": {
      "name": "app",
      "namespace": "flux-system"
    },
    "spec": {
      "commonMetadata": {
        "annotations": {
          "note": "${VALUE}"
        },
        "labels": {
          "kustomize.toolkit.fluxcd.io/name": "ks-common"
        }
      },
      "interval": "1m",
      "path": "./app",
      "postBuild": {
        "substitute": {
          "VALUE": "expanded"
        }
      },
      "sourceRef": {
        "kind": "GitRepository",
        "name": "flux-system"
      },
      "targetNamespace": "apps"
    }
  }
]
