[
  {
    "kind": "Kustomization",
    "name": "prefixed-app",
    "namespace": "one",
    "path": "./kubernetes/apps/one/app/workload",
    "prune": true,
    "sourceRef": {
      "kind": "GitRepository",
      "name": "flux-system",
      "namespace": "flux-system"
    },
    "targetNamespace": "one",
    "wait": false
  }
]
