---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: demo
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: demo
  namespace: apps
spec:
  chart:
    spec:
      chart: charts/jenkins-deployment
      ignoreMissingValuesFiles: false
      sourceRef:
        kind: GitRepository
        name: flux-system
        namespace: flux-system
      valuesFiles: []
  interval: 10m
  targetNamespace: target
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: sibling
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: sibling
  namespace: apps
spec:
  chart:
    spec:
      chart: charts/jenkins-deployment
      ignoreMissingValuesFiles: false
      sourceRef:
        kind: GitRepository
        name: flux-system
        namespace: flux-system
      valuesFiles: []
  interval: 10m
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: demo
  namespace: apps
spec:
  interval: 10m
  path: ./apps/demo/app
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: apps
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  labels:
    kustomize.toolkit.fluxcd.io/name: apps
    kustomize.toolkit.fluxcd.io/namespace: flux-system
  name: sibling
  namespace: apps
spec:
  interval: 10m
  path: ./apps/sibling/app
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: apps
---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: demo
    helm.toolkit.fluxcd.io/namespace: apps
  name: target-demo-values
  namespace: target
---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    helm.toolkit.fluxcd.io/name: sibling
    helm.toolkit.fluxcd.io/namespace: apps
  name: sibling-values
  namespace: apps
