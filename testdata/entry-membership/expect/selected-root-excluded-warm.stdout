---
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    value: resolved
  labels:
    kustomize.toolkit.fluxcd.io/name: child-dev
    kustomize.toolkit.fluxcd.io/namespace: apps
  name: visible
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: child-dev
  namespace: apps
spec:
  path: ./leaf
  postBuild:
    substituteFrom:
    - kind: ConfigMap
      name: settings-dev
